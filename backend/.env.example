# FraudShield AI — Backend Environment Variables
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
# ─────────────────────────────────────────────────────────────

# JWT signing secret — minimum 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — defaults shown
# ─────────────────────────────────────────────────────────────

# Environment mode: "production" or "development"
# In production, the app raises RuntimeError if JWT_SECRET_KEY is not set.
ENV=development

# Port to bind uvicorn
PORT=8008

# Comma-separated list of allowed frontend origins (no wildcards in production)
# Example: https://myapp.onrender.com,https://myapp.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SQLite database path (used for persistence layer)
DATABASE_URL=sqlite:///./db/fraudshield.db
